{
  "name": "retail-operations-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "db:migrate": "pnpm --filter @retail-ops/api db:migrate",
    "db:seed:demo": "pnpm --filter @retail-ops/api db:seed:demo",
    "db:grant-runtime": "pnpm --filter @retail-ops/api db:grant-runtime",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm coverage && pnpm build",
    "test:e2e": "node scripts/run-e2e.mjs",
    "screenshots": "node scripts/capture-readme-screenshots.mjs",
    "lint": "eslint .",
    "coverage": "pnpm --recursive coverage"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "3.3.18"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
